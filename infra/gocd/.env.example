# Copie para .env e ajuste se necessário (docker compose lê este arquivo automaticamente)
GOCD_VERSION=v26.2.0
# Chave compartilhada entre servidor e agentes para auto-registro (troque em ambientes reais)
GOCD_AGENT_AUTO_REGISTER_KEY=acervo-agentes-locais
# Caminho do repositório Git no host (padrão: raiz deste projeto)
ACERVO_REPO=../..
# GID do grupo dono do /var/run/docker.sock (Docker Desktop: 0; Linux: getent group docker | cut -d: -f3)
DOCKER_SOCKET_GID=0
