# Ambiente de PRODUÇÃO
# Persistente: os dados sobrevivem às novas implantações (volume Docker).
# A senha real deve ser fornecida por variável segura do GoCD (ACERVO_DB_SENHA);
# o valor padrão abaixo existe apenas para a demonstração local.
ACERVO_AMBIENTE=produção
ACERVO_PORTA=8080
ACERVO_AMBIENTE_EFEMERO=false
ACERVO_DB_SENHA=${ACERVO_DB_SENHA:-acervo-prd-local}
