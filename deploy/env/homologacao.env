# Ambiente de HOMOLOGAÇÃO (staging)
# Efêmero: é recriado do zero (inclusive o banco) a cada execução do pipeline,
# garantindo que os testes de aceitação rodem sempre sobre um estado conhecido.
ACERVO_AMBIENTE=homologação
ACERVO_PORTA=8081
ACERVO_AMBIENTE_EFEMERO=${ACERVO_AMBIENTE_EFEMERO:-true}
ACERVO_DB_SENHA=${ACERVO_DB_SENHA:-acervo-hml-local}
